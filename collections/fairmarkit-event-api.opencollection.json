{
  "opencollection": "1.0.0",
  "info": {
    "name": "BUYER PUBLIC Business Units Event API",
    "version": "3"
  },
  "items": [
    {
      "info": {
        "name": "Event",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Event Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://staging.fairmarkit.com/services/self-service/api/v4/event/:event_id",
            "headers": [
              {
                "name": "X-FM-API-KEY",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "event_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details for an event."
        },
        {
          "info": {
            "name": "List Events By Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://staging.fairmarkit.com/services/self-service/api/v4/event/:request_id/events",
            "headers": [
              {
                "name": "X-FM-API-KEY",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "request_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return. Defaults to 20."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset of the first record to return. Defaults to 0."
              }
            ]
          },
          "docs": "Returns events for a Request."
        },
        {
          "info": {
            "name": "Get Event Pricing Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://staging.fairmarkit.com/services/self-service/api/v4/event/:event_id/pricing/items",
            "headers": [
              {
                "name": "X-FM-API-KEY",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "event_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return. Defaults to 20."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset of the first record to return. Defaults to 0."
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Filter by item IDs."
              },
              {
                "name": "is_deleted",
                "value": "",
                "type": "query",
                "description": "Filter by deleted status."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search term used to filter results."
              }
            ]
          },
          "docs": "Returns pricing items for an event."
        }
      ]
    }
  ],
  "bundled": true
}